<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MTGProxyBuilder.UI.Converters"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        x:Class="MTGProxyBuilder.UI.MainWindow"
        x:Name="Root"
        Title="TCG Proxy Builder"
        Height="950" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBool"/>
        <converters:FlexibleNumberConverter x:Key="FlexibleNumber"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== PROJECT TAB BAR ==================== -->
        <Border Grid.Row="0" Background="#2D2D30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,2">
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding NewProjectCommand}" Content="+ New" Padding="8,4"/>
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding OpenProjectCommand}" Content="Open" Padding="8,4"/>
                    <Border Width="1" Background="#444" Margin="4,4"/>
                </StackPanel>

                <!-- Project tabs -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,5" Margin="1,2" CornerRadius="4,4,0,0"
                                    Cursor="Hand" Tag="{Binding}"
                                    Background="#3E3E42"
                                    PointerReleased="OnTabPointerReleased">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabTitle}" Foreground="#DDD" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="✕" Padding="4,0" Margin="6,0,0,0"
                                            Background="Transparent" Foreground="#888" BorderThickness="0"
                                            Cursor="Hand" FontSize="9" VerticalAlignment="Center"
                                            Click="OnTabClose" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,2">
                    <Button Theme="{StaticResource ToolBtn}" Content="Libraries  ▾" Padding="8,4">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Front Art Library" Command="{Binding ManageFrontArtLibraryCommand}"/>
                                <MenuItem Header="Back Art Library" Command="{Binding ManageBackArtLibraryCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding OpenSettingsCommand}"
                            Content="⚙ Settings" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== PER-PROJECT TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="6,4"
                DataContext="{Binding ActiveProject.Inner}"
                IsVisible="{Binding #Root.DataContext.HasActiveProject}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding SaveProjectCommand}" Content="Save"/>
                    <Border Width="1" Background="#444" Margin="6,4"/>
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding UndoCommand}" Content="Undo" ToolTip.Tip="Ctrl+Z"/>
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding RedoCommand}" Content="Redo" ToolTip.Tip="Ctrl+Y"/>
                    <Border Width="1" Background="#444" Margin="6,4"/>
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding AddCardFromFileCommand}" Content="+ File"/>
                    <Border Width="1" Background="#444" Margin="6,4"/>
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding ClearAllCardsCommand}" Content="Clear All" Foreground="#E06060"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Project:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox Text="{Binding ProjectName}" Width="180" Padding="6,4" FontSize="12"
                             Background="#3E3E42" Foreground="White" BorderBrush="#555" BorderThickness="1"
                             CaretBrush="White"/>
                </StackPanel>

                <Border Grid.Column="2"/>

                <Button Grid.Column="3" Theme="{StaticResource AccentBtn}"
                        Command="{Binding ExportPdfCommand}" Content="Export PDF" Margin="4,0"/>
            </Grid>
        </Border>

        <!-- ==================== UPDATE BANNER ==================== -->
        <Border Grid.Row="2" Background="#4A3800" Padding="10,6"
                IsVisible="{Binding UpdateAvailable}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠" Foreground="#FFB800" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding UpdateMessage}" Foreground="#FFD" FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Download" Padding="10,4" Margin="8,0"
                        Background="#7A6FB0" Foreground="White" BorderThickness="0"
                        Cursor="Hand" FontSize="11" Command="{Binding DownloadUpdateCommand}"/>
                <Button Grid.Column="3" Content="✕" Padding="6,2"
                        Background="Transparent" Foreground="#AA9" BorderThickness="0"
                        Cursor="Hand" FontSize="12" Command="{Binding DismissUpdateCommand}" ToolTip.Tip="Dismiss"/>
            </Grid>
        </Border>

        <!-- ==================== WELCOME SCREEN (no project open) ==================== -->
        <Border Grid.Row="3" Background="#1E1E1E"
                IsVisible="{Binding !HasActiveProject}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="TCG Proxy Builder" Foreground="#555" FontSize="36"
                           FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock Text="Create or open a project to get started" Foreground="#444"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Theme="{StaticResource AccentBtn}" Command="{Binding NewProjectCommand}"
                            Content="New Project" Padding="16,8" FontSize="13" Margin="0,0,10,0"/>
                    <Button Theme="{StaticResource ToolBtn}" Command="{Binding OpenProjectCommand}"
                            Content="Open Project" Padding="16,8" FontSize="13" Background="#3E3E42"/>
                </StackPanel>
                <TextBlock Foreground="#444" FontSize="11" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneTime}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ==================== MAIN AREA ==================== -->
        <Grid Grid.Row="3" DataContext="{Binding ActiveProject.Inner}"
              IsVisible="{Binding #Root.DataContext.HasActiveProject}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: Input panel (search / import / add cards) ===== -->
            <TabControl Grid.Column="0" Background="#2D2D30" Padding="0">
                    <!-- ===== ADD CARDS PANEL ===== -->
                    <TabItem Header="Add Cards" Foreground="#AAA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2D2D30">
                            <StackPanel Margin="10,8">
                                <!-- Add cards by name. One per line; a single line adds one card. -->
                                <TextBlock Text="Add Cards by Name" FontWeight="SemiBold" Foreground="#CCC"
                                           Margin="0,0,0,6" FontSize="12"/>
                                <TextBlock Text="One card per line, e.g. &quot;2 Sol Ring&quot; or &quot;Lightning Bolt&quot;. Write a single name to add just one card. Prefix a line with &quot;t:&quot; to add a token, e.g. &quot;t: Goblin&quot;."
                                           Foreground="#666" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ImportDeckText}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="180" Padding="6,5" FontSize="11"
                                         VerticalContentAlignment="Top"
                                         Background="#3E3E42" Foreground="White"
                                         BorderBrush="#555" BorderThickness="1" CaretBrush="White"/>
                                <Button Theme="{StaticResource AccentBtn}"
                                        Command="{Binding ImportTextListCommand}" Content="Add Cards from List"
                                        HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"/>

                                <TextBlock Text="Import Deck" FontWeight="SemiBold" Foreground="#CCC"
                                           Margin="0,16,0,6" FontSize="12"/>
                                <TextBlock Text="Paste a URL from Moxfield or Archidekt"
                                           Foreground="#666" FontSize="10" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DeckImportUrlBox" Text="{Binding ImportDeckUrl}"
                                             Padding="6,5" FontSize="11"
                                             Background="#3E3E42" Foreground="White"
                                             BorderBrush="#555" BorderThickness="1" CaretBrush="White"/>
                                    <Button Grid.Column="1" Theme="{StaticResource AccentBtn}"
                                            Command="{Binding ImportDeckCommand}" Content="Import"
                                            Margin="4,0,0,0" Padding="10,5"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding IgnoreDuplicates}"
                                          Content="Skip cards already in project (merge basics)"
                                          Foreground="#999" FontSize="10" Margin="0,2,0,0"/>

                                <TextBlock Text="Import MPCFill Project" FontWeight="SemiBold" Foreground="#CCC"
                                           Margin="0,16,0,6" FontSize="12"/>
                                <Button Theme="{StaticResource AccentBtn}" Command="{Binding ImportMpcFillXmlCommand}"
                                        Content="Import cards.xml..." HorizontalAlignment="Stretch" Padding="8,6"/>
                                <TextBlock Text="Import a cards.xml file exported from MPCFill"
                                           Foreground="#666" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
            </TabControl>

            <!-- ===== SPLITTER (left) ===== -->
            <GridSplitter Grid.Column="1" Background="#3E3E42" ResizeDirection="Columns"/>

            <!-- ===== LEFT: Canvas / Page Preview ===== -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">

                <!-- Compact filter / sort bar above the grid (replaces the old Filter tab) -->
                <Border Grid.Row="0" Background="#2D2D30" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Filter" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding FilterText}" Width="160" Padding="6,3" FontSize="11"
                                 Watermark="name…"
                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                        <ComboBox ItemsSource="{Binding RarityOptions}" SelectedItem="{Binding FilterRarity}"
                                  MinWidth="90" Padding="4,2" FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding FilterColor}"
                                  MinWidth="90" Padding="4,2" FontSize="11" VerticalAlignment="Center"/>
                        <Border Width="1" Background="#555" Margin="2,2"/>
                        <TextBlock Text="Sort" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}"
                                  MinWidth="110" Padding="4,2" FontSize="11" VerticalAlignment="Center"/>
                        <CheckBox Content="Desc" IsChecked="{Binding SortDescending}"
                                  Foreground="#CCC" FontSize="11" VerticalAlignment="Center"/>
                        <Button Theme="{StaticResource ToolBtn}" Command="{Binding ApplySortToProjectCommand}"
                                Content="Apply" Padding="8,3" FontSize="11"/>
                        <Button Theme="{StaticResource ToolBtn}" Command="{Binding ClearFilterCommand}"
                                Content="Clear" Padding="8,3" FontSize="11"/>
                        <TextBlock Foreground="#999" FontSize="11" VerticalAlignment="Center">
                            <Run Text="{Binding FilteredCards.Count, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding Cards.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#1E1E1E">
                    <Border Padding="30" HorizontalAlignment="Center">
                        <Border BoxShadow="0 4 20 0 #59000000">
                            <controls:GridEditorCanvas
                                x:Name="GridCanvas"
                                HorizontalAlignment="Left"
                                PageSettings="{Binding CurrentProject.PageSettings}"
                                CardsSource="{Binding Cards}"
                                ShowCutGuides="{Binding CurrentProject.PrintSettings.ShowCutGuides}"
                                PrintSettingsSource="{Binding CurrentProject.PrintSettings}"
                                SelectedCard="{Binding SelectedCard, Mode=TwoWay}"
                                RefreshTrigger="{Binding RefreshTrigger}"
                                UndoSvc="{Binding UndoServiceInstance}"/>
                        </Border>
                    </Border>
                </ScrollViewer>

                <!-- Zoom indicator -->
                <Border Background="#CC2D2D30" CornerRadius="4" Padding="8,4"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="-" Padding="6,1" FontSize="14" FontWeight="Bold"
                                Background="Transparent" Foreground="#CCC" BorderThickness="0"
                                Cursor="Hand" Click="ZoomOut"/>
                        <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#CCC" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0" MinWidth="36" TextAlignment="Center"/>
                        <Button Content="+" Padding="6,1" FontSize="14" FontWeight="Bold"
                                Background="Transparent" Foreground="#CCC" BorderThickness="0"
                                Cursor="Hand" Click="ZoomIn"/>
                        <Border Width="1" Background="#555" Margin="6,2"/>
                        <Button Content="Fit" Padding="6,1" FontSize="11"
                                Background="Transparent" Foreground="#AAA" BorderThickness="0"
                                Cursor="Hand" Click="ZoomFit"/>
                        <Button Content="1:1" Padding="6,1" FontSize="11"
                                Background="Transparent" Foreground="#AAA" BorderThickness="0"
                                Cursor="Hand" Click="ZoomReset"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== SPLITTER ===== -->
            <!-- ===== SPLITTER (right) ===== -->
            <GridSplitter Grid.Column="3" Background="#3E3E42" ResizeDirection="Columns"/>

            <!-- ===== RIGHT: Tool panels as tabs ===== -->
            <TabControl Grid.Column="4" Background="#2D2D30" Padding="0">


                <!-- ===== CARD PANEL ===== -->
                <TabItem Header="Card" Foreground="#AAA">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2D2D30">
                        <StackPanel Margin="10,8">
                            <TextBlock Text="(Click a card on the page)" Foreground="#666"
                                       FontStyle="Italic" FontSize="12" Margin="0,0,0,8"
                                       IsVisible="{Binding SelectedCard, Converter={StaticResource NullToCollapsed}, ConverterParameter=inverse}"/>

                            <StackPanel IsVisible="{Binding SelectedCard, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="Name" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedCard.Name}" Padding="6,4" FontSize="12"
                                         Background="#3E3E42" Foreground="White" BorderBrush="#555"
                                         CaretBrush="White" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Quantity" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding SelectedCard.Quantity}" Padding="6,4"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Mana Cost" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedCard.ManaCost}" Foreground="#CCC"
                                                   FontSize="12" Padding="6,5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- fork-specific: split one copy off a stacked card so it can be edited alone.
                                     Disabled (greyed) when this card has only one copy. -->
                                <Button Theme="{StaticResource ToolBtn}"
                                        Command="{Binding UnlinkCardCopyCommand}"
                                        Content="✂  Unlink This Copy"
                                        ToolTip.Tip="Split 1 copy off this stack so you can edit it separately from the others"
                                        Background="#3E3E42" Foreground="#CCC"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="8,5" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding SelectedCard.TypeLine}" Foreground="#AAA"
                                           FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedCard.OracleText}" Foreground="#888"
                                           FontSize="10" TextWrapping="Wrap" MaxHeight="80"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                <TextBlock Foreground="#666" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10">
                                    <Run Text="{Binding SelectedCard.SetName, Mode=OneWay}"/>
                                    <Run Text=" #"/><Run Text="{Binding SelectedCard.CollectorNumber, Mode=OneWay}"/>
                                    <Run Text=" | "/><Run Text="{Binding SelectedCard.Rarity, Mode=OneWay}"/>
                                    <Run Text=" | "/><Run Text="{Binding SelectedCard.Artist, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- fork-specific: image adjustment (brightness/contrast/saturation/black-point) -->
                                <Button Theme="{StaticResource AccentBtn}"
                                        Command="{Binding AdjustImageCommand}"
                                        Content="Adjust Image…" Margin="0,0,0,12"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="8,8" FontWeight="SemiBold"/>

                                <Separator Margin="0,2,0,8" Background="#3A3A3D"/>
                                <TextBlock Text="Front Artwork" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                <Button Theme="{StaticResource AccentBtn}"
                                        Command="{Binding BrowseFrontArtworkCommand}"
                                        Content="Select Art..." Margin="0,0,0,6"
                                        HorizontalAlignment="Stretch" Padding="8,6"/>
                                <Border Height="300" Background="#111" CornerRadius="4" Margin="0,0,0,4"
                                        ClipToBounds="True">
                                    <Image Stretch="Uniform" Margin="4"
                                           converters:ImageLoader.Source="{Binding SelectedCard.ArtworkPath}"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedCard.ArtworkPath}" Foreground="#555"
                                           FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                <CheckBox Content="Include Back Artwork"
                                          IsChecked="{Binding SelectedCard.IncludeBack}"
                                          Foreground="#CCC" Margin="0,0,0,6"/>
                                <Button Theme="{StaticResource AccentBtn}"
                                        Command="{Binding BrowseBackArtworkCommand}"
                                        Content="Select Card Back..." Margin="0,0,0,6"
                                        HorizontalAlignment="Stretch" Padding="8,6"/>
                                <Border Height="300" Background="#111" CornerRadius="4" Margin="0,0,0,4"
                                        ClipToBounds="True">
                                    <Image Stretch="Uniform" Margin="4"
                                           converters:ImageLoader.Source="{Binding SelectedCard.BackArtworkPath}"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedCard.BackArtworkPath}" Foreground="#555"
                                           FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== LAYOUT PANEL ===== -->
                <TabItem Header="Layout" Foreground="#AAA">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2D2D30">
                        <StackPanel Margin="10,8">
                            <TextBlock Text="PAGE" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Page Size" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding PagePresets}" SelectedItem="{Binding SelectedPagePreset}"
                                      Padding="4" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Landscape" IsChecked="{Binding CurrentProject.PageSettings.IsLandscape}"
                                      Foreground="#CCC" Margin="0,0,0,10"/>

                            <TextBlock Text="PRINT" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                            <TextBlock Text="Print Mode" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding PrintModeValues}" SelectedItem="{Binding SelectedPrintMode}"
                                      Padding="4" Margin="0,0,0,6" FontSize="11"/>
                            <CheckBox Content="Cutting guides (edge-to-edge)"
                                      IsChecked="{Binding CurrentProject.PrintSettings.ShowCutGuides}"
                                      Foreground="#CCC" Margin="0,0,0,6"/>

                            <TextBlock Text="CARD OUTLINE" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                            <CheckBox Content="Show card outline guides"
                                      IsChecked="{Binding CurrentProject.PrintSettings.ShowCardOutline}"
                                      Foreground="#CCC" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Color" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.OutlineColor}"
                                             Padding="4,3" FontSize="11"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Line Weight (pt)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.LineWeight, Converter={StaticResource FlexibleNumber}}"
                                             Padding="4,3" FontSize="11"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Alignment" Foreground="#999" FontSize="9"/>
                                    <ComboBox ItemsSource="{Binding OutlineAlignmentOptions}"
                                              SelectedItem="{Binding SelectedOutlineAlignment}" Padding="3" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Outline Type" Foreground="#999" FontSize="9"/>
                                    <ComboBox ItemsSource="{Binding OutlineTypeOptions}"
                                              SelectedItem="{Binding SelectedOutlineType}" Padding="3" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Corner Radius (mm)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.CornerRadiusMm, Converter={StaticResource FlexibleNumber}}"
                                             Padding="4,3" FontSize="11" Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Line Type" Foreground="#999" FontSize="9"/>
                                    <ComboBox ItemsSource="{Binding LineTypeOptions}" SelectedItem="{Binding SelectedLineType}"
                                              Padding="3" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Corner Length (mm)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.CornerLengthMm, Converter={StaticResource FlexibleNumber}}"
                                             Padding="4,3" FontSize="11" Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,4"/>

                            <TextBlock Text="SILHOUETTE CAMEO" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                            <CheckBox Content="Add registration marks to PDF"
                                      IsChecked="{Binding CurrentProject.PrintSettings.ShowRegistrationMarks}"
                                      Foreground="#CCC" Margin="0,0,0,4"/>
                            <CheckBox Content="Export SVG cut lines with PDF"
                                      IsChecked="{Binding CurrentProject.PrintSettings.ExportSvgCutLines}"
                                      Foreground="#CCC" Margin="0,0,0,4"/>
                            <Button Content="Export SVG Only" Command="{Binding ExportSvgCommand}"
                                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0"
                                    Padding="8,4" FontSize="11" Cursor="Hand" HorizontalAlignment="Left"
                                    Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4"
                                  IsVisible="{Binding CurrentProject.PrintSettings.ShowRegistrationMarks}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Square (in)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.RegMarkSquareSizeIn, Converter={StaticResource FlexibleNumber}}"
                                             Padding="4,3" FontSize="11" Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Arm Length (in)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.RegMarkLengthIn, Converter={StaticResource FlexibleNumber}}"
                                             Padding="4,3" FontSize="11" Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Thickness (in)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.RegMarkThicknessIn, Converter={StaticResource FlexibleNumber}}"
                                             Padding="4,3" FontSize="11" Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Inset (in)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PrintSettings.RegMarkInsetIn, Converter={StaticResource FlexibleNumber}}"
                                             Padding="4,3" FontSize="11" Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,4"/>

                            <TextBlock Text="CARD SIZE" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width (mm)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PageSettings.CardWidthMm}" Padding="4" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (mm)" Foreground="#999" FontSize="9"/>
                                    <TextBox Text="{Binding CurrentProject.PageSettings.CardHeightMm}" Padding="4" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bleed: trim margin around the card. The cut line stays on the card edge;
                                 this only changes how much is trimmed (0 .. 1/8", the MPCFill maximum). -->
                            <TextBlock Text="BLEED" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,10,0,6"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Trim margin (cut line stays on the card edge)"
                                           Foreground="#999" FontSize="9" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentProject.PageSettings.BleedWidthMm, StringFormat={}{0:0.00} mm}"
                                           Foreground="#9B8FD4" FontSize="10" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="3.048"
                                    Value="{Binding CurrentProject.PageSettings.BleedWidthMm}"
                                    SmallChange="0.1" LargeChange="0.5" Margin="0,0,0,2"
                                    ToolTip.Tip="Bleed is the extra image kept around the card so trimming never leaves a white edge. The cut line stays on the card border; this only changes how much margin gets trimmed. 0 = none, 3.05 mm = the 1/8&quot; MakePlayingCards standard."/>
                            <TextBlock Text="0 = no bleed · max = 1/8 in (3.05 mm, MakePlayingCards standard)"
                                       Foreground="#666" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <!-- Card position adjustment: shift the WHOLE grid on the sheet to compensate
                                 for printer offset (e.g. backs not landing on fronts). Does not change
                                 card spacing or bleed — only the centering on the page. -->
                            <TextBlock Text="CARD POSITION ADJUSTMENT (mm)" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,12,0,6"/>
                            <TextBlock Text="Nudges the whole layout on the sheet to compensate for printer offset. Does not change card spacing or bleed."
                                       Foreground="#666" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Horizontal offset (+ right, − left)"
                                           Foreground="#999" FontSize="9" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentProject.PageSettings.OffsetXmm, StringFormat={}{0:0.0} mm}"
                                           Foreground="#9B8FD4" FontSize="10" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Minimum="-10" Maximum="10"
                                    Value="{Binding CurrentProject.PageSettings.OffsetXmm}"
                                    SmallChange="0.1" LargeChange="1" TickFrequency="1" Margin="0,0,0,4"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Vertical offset (+ down, − up)"
                                           Foreground="#999" FontSize="9" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentProject.PageSettings.OffsetYmm, StringFormat={}{0:0.0} mm}"
                                           Foreground="#9B8FD4" FontSize="10" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Minimum="-10" Maximum="10"
                                    Value="{Binding CurrentProject.PageSettings.OffsetYmm}"
                                    SmallChange="0.1" LargeChange="1" TickFrequency="1" Margin="0,0,0,4"/>

                            <TextBlock Text="GRID" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,12,0,6"/>
                            <TextBlock Text="Leave blank to auto-fit" Foreground="#666" FontSize="9" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="#999" FontSize="9">
                                        <Run Text="Columns (auto: "/>
                                        <Run Text="{Binding CurrentProject.PageSettings.AutoCardsPerRow, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <TextBox Text="{Binding CurrentProject.PageSettings.ColumnsOverride}" Padding="4" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="#999" FontSize="9">
                                        <Run Text="Rows (auto: "/>
                                        <Run Text="{Binding CurrentProject.PageSettings.AutoCardsPerColumn, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                    <TextBox Text="{Binding CurrentProject.PageSettings.RowsOverride}" Padding="4" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="INFO" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                            <TextBlock Foreground="#AAA" FontSize="11" Margin="0,2">
                                <Run Text="Grid: "/>
                                <Run Text="{Binding CurrentProject.PageSettings.CardsPerRow, Mode=OneWay}"/>
                                <Run Text=" x "/>
                                <Run Text="{Binding CurrentProject.PageSettings.CardsPerColumn, Mode=OneWay}"/>
                                <Run Text="  |  "/>
                                <Run Text="{Binding CurrentProject.PageSettings.CardsPerPage, Mode=OneWay}"/>
                                <Run Text="/page"/>
                            </TextBlock>
                            <TextBlock Foreground="#AAA" FontSize="11" Margin="0,2">
                                <Run Text="Page: "/>
                                <Run Text="{Binding CurrentProject.PageSettings.PageWidthMm, Mode=OneWay, StringFormat={}{0:0}}"/>
                                <Run Text=" x "/>
                                <Run Text="{Binding CurrentProject.PageSettings.PageHeightMm, Mode=OneWay, StringFormat={}{0:0}}"/>
                                <Run Text=" mm"/>
                            </TextBlock>
                            <TextBlock Foreground="#AAA" FontSize="11" Margin="0,2">
                                <Run Text="Cards: "/>
                                <Run Text="{Binding Cards.Count, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Text="STORAGE" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CacheSizeText}" Foreground="#AAA" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Theme="{StaticResource ToolBtn}"
                                        Command="{Binding ClearCacheCommand}" Content="Clear Cache"
                                        Padding="8,3" FontSize="10"/>
                            </Grid>

                            <TextBlock Text="BACK ART" Foreground="#7A6FB0" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                            <Button Theme="{StaticResource AccentBtn}"
                                    Command="{Binding SelectBackArtForAllCommand}"
                                    Content="Select Back for All Cards..."
                                    HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>


            </TabControl>
        </Grid>

        <!-- ==================== STATUS BAR ==================== -->
        <Border Grid.Row="4" Background="#6A5FA0" Padding="8,3"
                DataContext="{Binding ActiveProject.Inner}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Column="1" Foreground="#CCE8FF" FontSize="11">
                    <Run Text="{Binding Cards.Count, Mode=OneWay}"/>
                    <Run Text=" cards"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ==================== SHELL LOADING OVERLAY ==================== -->
        <Border Grid.RowSpan="5" Background="#CC000000"
                IsVisible="{Binding IsLoading}">
            <Border Background="#2D2D30" CornerRadius="8" Padding="30,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300"
                    BorderBrush="#7A6FB0" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding LoadingMessage}" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait..." Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== BUSY OVERLAY ==================== -->
        <Border Grid.RowSpan="5" Background="#CC000000"
                DataContext="{Binding ActiveProject.Inner}"
                IsVisible="{Binding IsBusy, FallbackValue=False}">
            <Border Background="#2D2D30" CornerRadius="8" Padding="30,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300"
                    BorderBrush="#7A6FB0" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="320"/>
                    <TextBlock Text="Please wait..." Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Button Content="Cancel" Command="{Binding CancelBusyCommand}"
                            IsVisible="{Binding BusyIsCancellable}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Padding="18,6"
                            Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
