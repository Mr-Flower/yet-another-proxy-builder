<Window x:Class="MTGProxyBuilder.UI.Dialogs.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        xmlns:vm="clr-namespace:MTGProxyBuilder.UI.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800" MinWidth="800" MinHeight="500"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <!-- File operations -->
                <Button Content="New" Style="{StaticResource ToolBtn}" Command="{Binding NewCommand}"
                        ToolTip="New project" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="Open" Style="{StaticResource ToolBtn}" Command="{Binding OpenCommand}"
                        ToolTip="Open project" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="Save" Style="{StaticResource ToolBtn}" Command="{Binding SaveCommand}"
                        ToolTip="Save project (Ctrl+S)" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <!-- Export -->
                <Button Content="Export PNG" Style="{StaticResource AccentBtn}" Command="{Binding ExportImageCommand}"
                        ToolTip="Export as image" Padding="10,4" Margin="0,0,2,0" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <!-- Layer shortcuts -->
                <Button Content="+ Image" Style="{StaticResource ToolBtn}" Command="{Binding AddImageLayerCommand}"
                        ToolTip="Add image layer" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="+ Text" Style="{StaticResource ToolBtn}" Command="{Binding AddTextLayerCommand}"
                        ToolTip="Add text layer" Padding="8,4" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <!-- Card info -->
                <TextBlock VerticalAlignment="Center" Foreground="#888888" FontSize="10" Margin="4,0">
                    <Run Text="{Binding Project.CardWidthPx, Mode=OneWay}"/>
                    <Run Text="x"/>
                    <Run Text="{Binding Project.CardHeightPx, Mode=OneWay}"/>
                    <Run Text="px"/>
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Layer List Panel -->
            <controls:LayerListPanel Grid.Column="0" DataContext="{Binding}"
                                     controls:LayerListPanel.AddImageLayerRequested="OnAddImageLayer"
                                     controls:LayerListPanel.AddTextLayerRequested="OnAddTextLayer"
                                     controls:LayerListPanel.DeleteLayerRequested="OnDeleteLayer"
                                     controls:LayerListPanel.MoveUpRequested="OnMoveUp"
                                     controls:LayerListPanel.MoveDownRequested="OnMoveDown"/>

            <GridSplitter Grid.Column="1" Width="3" Background="#333333"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Card Editor Canvas -->
            <controls:CardEditorCanvas Grid.Column="2" x:Name="EditorCanvas"
                                        Project="{Binding Project}"
                                        SelectedLayer="{Binding SelectedLayer, Mode=TwoWay}"
                                        RefreshTrigger="{Binding RefreshTrigger}"/>

            <GridSplitter Grid.Column="3" Width="3" Background="#333333"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Property Panel -->
            <controls:PropertyPanel Grid.Column="4" x:Name="PropPanel" DataContext="{Binding}"
                                     controls:PropertyPanel.BrowseImageRequested="OnBrowseImage"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="#888888" FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" Foreground="#666666" FontSize="10"
                           VerticalAlignment="Center">
                    <Run Text="Layers:"/>
                    <Run Text="{Binding Layers.Count, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
