<Window x:Class="MTGProxyBuilder.UI.Dialogs.BackArtLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Back Art Library" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Back Art Library" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" x:Name="CountLabel" Foreground="#888" FontSize="11" Margin="0,24,0,8"/>

        <!-- Actions bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
            <Button Content="Add from File..." Padding="10,5" Margin="0,0,6,0"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnAddFromFile"/>
            <Button Content="Download MPCFill Card Backs" Padding="10,5" Margin="0,0,6,0"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnDownloadMpcFill" x:Name="DownloadBtn"/>
            <Button Content="Set as Default" Padding="10,5" Margin="0,0,6,0"
                    Background="Transparent" Foreground="#4CAF50" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnSetDefault" x:Name="DefaultBtn" IsEnabled="False"/>
            <Button Content="Clear Default" Padding="10,5" Margin="0,0,6,0"
                    Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnClearDefault" x:Name="ClearDefaultBtn"/>
            <Button Content="Remove Selected" Padding="10,5"
                    Background="Transparent" Foreground="#E06060" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnRemoveSelected" x:Name="RemoveBtn" IsEnabled="False"/>
        </StackPanel>

        <!-- Filter bar -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Padding="6,4" FontSize="11"
                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"
                     TextChanged="OnFilterChanged"/>
            <ComboBox Grid.Column="2" x:Name="SourceFilter" Padding="4" FontSize="11"
                      SelectionChanged="OnFilterChanged"/>
        </Grid>

        <!-- Main content: Grid + Preview side by side -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Library grid -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="LibraryPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Preview panel -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Image preview (zoomable) -->
                    <ScrollViewer Grid.Row="0" x:Name="PreviewScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#111" PreviewMouseWheel="OnPreviewMouseWheel">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6">
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Image.LayoutTransform>
                                    <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                </Image.LayoutTransform>
                            </Image>
                        </Border>
                    </ScrollViewer>

                    <!-- Info panel -->
                    <Border Grid.Row="1" Background="#1E1E1E" Padding="8,6" CornerRadius="0,0,4,4">
                        <StackPanel>
                            <TextBlock x:Name="PreviewName" Text="Select an image" Foreground="#CCC" FontSize="12"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewInfo" Foreground="#888" FontSize="10" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="-" Padding="6,1" FontSize="12" FontWeight="Bold"
                                        Background="Transparent" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomOut"/>
                                <TextBlock x:Name="PreviewZoomLabel" Text="Fit" Foreground="#888" FontSize="10"
                                           VerticalAlignment="Center" Margin="6,0" MinWidth="32" TextAlignment="Center"/>
                                <Button Content="+" Padding="6,1" FontSize="12" FontWeight="Bold"
                                        Background="Transparent" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomIn"/>
                                <Border Width="1" Background="#444" Margin="6,2"/>
                                <Button Content="Fit" Padding="5,1" FontSize="10"
                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomFit"/>
                                <Button Content="1:1" Padding="5,1" FontSize="10"
                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomReset"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status + Close -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Padding="14,7"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="12" FontWeight="SemiBold" IsCancel="True" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
