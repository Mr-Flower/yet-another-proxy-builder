<Window x:Class="MTGProxyBuilder.UI.Dialogs.BackArtLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        Title="Back Art Library" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Back Art Library" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" x:Name="CountLabel" Foreground="#888" FontSize="11" Margin="0,24,0,8"/>

        <!-- Actions bar -->
        <StackPanel Grid.Row="1" Margin="0,4,0,6">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Add from File..." Padding="10,5" Margin="0,0,6,0"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnAddFromFile"/>
                <Button Content="Download MPCFill Card Backs" Padding="10,5" Margin="0,0,6,0"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnDownloadMpcFill" x:Name="DownloadBtn"/>
                <Button Content="Set as Default" Padding="10,5" Margin="0,0,6,0"
                        Background="Transparent" Foreground="#4CAF50" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnSetDefault" x:Name="DefaultBtn" IsEnabled="False"/>
                <Button Content="Clear Default" Padding="10,5" Margin="0,0,6,0"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnClearDefault" x:Name="ClearDefaultBtn"/>
                <Button Content="Remove Selected" Padding="10,5" Margin="0,0,6,0"
                        Background="Transparent" Foreground="#E06060" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnRemoveSelected" x:Name="RemoveBtn" IsEnabled="False"/>
                <Button Content="Regenerate Thumbnails" Padding="10,5"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnRegenerateThumbnails" x:Name="RegenThumbBtn"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Move Library..." Padding="10,5" Margin="0,0,6,0"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnMoveLibrary"/>
                <Button Content="Export as ZIP..." Padding="10,5" Margin="0,0,6,0"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnExportZip"/>
                <Button Content="Import from ZIP..." Padding="10,5"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnImportZip"/>
            </StackPanel>
        </StackPanel>

        <!-- Search bar -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Padding="6,4" FontSize="11"
                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"
                     KeyDown="OnSearchKeyDown"
                     ToolTip="Scryfall-like syntax: name:text source:text date&gt;2025-01-01 &quot;exact phrase&quot; -exclude term1 OR term2"/>
            <Button Grid.Column="1" Content="Search" Padding="10,4" Margin="4,0,0,0"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnSearchClick"/>
            <ComboBox Grid.Column="3" x:Name="SourceFilter" Padding="4" FontSize="11"
                      SelectionChanged="OnSourceFilterChanged"/>
        </Grid>

        <!-- Main content: Grid + Preview side by side -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Library grid -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="LibraryPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Preview panel -->
            <controls:ImagePreviewPanel x:Name="PreviewPanel" Grid.Column="1"/>
        </Grid>

        <!-- Status + Close -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Padding="14,7"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="12" FontWeight="SemiBold" IsCancel="True" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
