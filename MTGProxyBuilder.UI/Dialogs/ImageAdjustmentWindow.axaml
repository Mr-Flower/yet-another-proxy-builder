<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MTGProxyBuilder.UI.Dialogs.ImageAdjustmentWindow"
        Title="Blacken Border"
        Width="760" Height="520" MinWidth="680" MinHeight="460"
        Background="#2D2D30"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="16" ColumnDefinitions="*,300" RowDefinitions="*,Auto">

        <!-- ============ PREVIEW (original vs adjusted) ============ -->
        <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*,Auto,*" Margin="0,0,16,0">
            <TextBlock Grid.Row="0" Text="Original" Foreground="#999" FontSize="11" Margin="0,0,0,4"/>
            <Border Grid.Row="1" Background="#111" CornerRadius="4">
                <Image x:Name="OriginalPreview" Stretch="Uniform" Margin="6"/>
            </Border>
            <TextBlock Grid.Row="2" Text="Adjusted Preview" Foreground="#4a9eff"
                       FontSize="11" Margin="0,8,0,4"/>
            <Border Grid.Row="3" Background="#111" CornerRadius="4">
                <Image x:Name="AdjustedPreview" Stretch="Uniform" Margin="6"/>
            </Border>
        </Grid>

        <!-- ============ CONTROLS ============ -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="2">

            <!-- Blacken border -->
            <CheckBox x:Name="BlackenBorderCheck" Content="Blacken card border"
                      Foreground="#CCC" FontWeight="SemiBold" Margin="0,0,0,2"
                      IsCheckedChanged="OnToggle"/>
            <TextBlock Text="Floods the dark border inward from the image edges to pure black — fixes grey / grainy scan borders. The card art is left untouched."
                       Foreground="#777" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid ColumnDefinitions="*,44">
                <TextBlock Text="Border threshold" Foreground="#CCC" FontSize="12"/>
                <TextBlock x:Name="ThresholdLabel" Grid.Column="1" Text="64"
                           Foreground="#4a9eff" FontSize="12" TextAlignment="Right"/>
            </Grid>
            <TextBlock Text="How grey still counts as border. Higher blackens more; too high can creep into the card."
                       Foreground="#777" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"/>
            <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="80" Value="64"
                    SmallChange="1" LargeChange="8" ValueChanged="OnSliderChanged" Margin="0,0,0,12"/>

            <Border Height="1" Background="#444" Margin="0,0,0,10"/>

            <!-- Apply to (per-source target) -->
            <TextBlock Text="Apply to" Foreground="#CCC" FontSize="12" Margin="0,0,0,2"/>
            <ComboBox x:Name="TargetCombo" HorizontalAlignment="Stretch" Margin="0,0,0,10" SelectedIndex="0">
                <ComboBoxItem>This card only</ComboBoxItem>
                <ComboBoxItem>All Scryfall cards</ComboBoxItem>
                <ComboBoxItem>All MPCFill cards</ComboBoxItem>
                <ComboBoxItem>All cards (both sources)</ComboBoxItem>
            </ComboBox>

            <CheckBox x:Name="AutoApplyCheck"
                      Content="Apply automatically to new Scryfall cards"
                      Foreground="#CCC" Margin="0,0,0,4"/>
            <TextBlock Text="Use the values above as the default for every newly imported image."
                       Foreground="#777" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <Button x:Name="SaveDefaultBtn" Content="Save as Default"
                    HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,4"
                    Background="#3E3E42" Foreground="White" BorderThickness="0"
                    Click="OnSaveDefault"/>
            <TextBlock x:Name="StatusLabel" Text="" Foreground="#6a9955" FontSize="10"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
        </StackPanel>
        </ScrollViewer>

        <!-- ============ BUTTONS ============ -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ResetBtn" Content="Reset" Padding="12,6"
                    Background="#3E3E42" Foreground="White" BorderThickness="0" Click="OnReset"/>
            <Button x:Name="CancelBtn" Content="Cancel" Padding="12,6"
                    Background="#3E3E42" Foreground="White" BorderThickness="0" Click="OnCancel"/>
            <Button x:Name="ApplyBtn" Content="Apply" Padding="14,6"
                    Background="#7A6FB0" Foreground="White" BorderThickness="0" Click="OnApply"/>
        </StackPanel>
    </Grid>
</Window>
