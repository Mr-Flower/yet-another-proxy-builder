<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        xmlns:vm="clr-namespace:MTGProxyBuilder.UI.ViewModels"
        x:Class="MTGProxyBuilder.UI.Dialogs.CardEditorWindow"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800" MinWidth="800" MinHeight="500"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <!-- File operations -->
                <Button Content="New" Theme="{StaticResource ToolBtn}" Command="{Binding NewCommand}"
                        ToolTip.Tip="New project" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="Open" Theme="{StaticResource ToolBtn}" Command="{Binding OpenCommand}"
                        ToolTip.Tip="Open project" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="Save" Theme="{StaticResource ToolBtn}" Command="{Binding SaveCommand}"
                        ToolTip.Tip="Save project (Ctrl+S)" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <!-- Export -->
                <Button Content="Export PNG" Theme="{StaticResource AccentBtn}" Command="{Binding ExportImageCommand}"
                        ToolTip.Tip="Export as image" Padding="10,4" Margin="0,0,2,0" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <!-- Layer shortcuts -->
                <Button Content="+ Image" Theme="{StaticResource ToolBtn}" Command="{Binding AddImageLayerCommand}"
                        ToolTip.Tip="Add image layer" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="+ Text" Theme="{StaticResource ToolBtn}" Command="{Binding AddTextLayerCommand}"
                        ToolTip.Tip="Add text layer" Padding="8,4" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <!-- Card info -->
                <TextBlock VerticalAlignment="Center" Foreground="#888888" FontSize="10" Margin="4,0">
                    <Run Text="{Binding Project.CardWidthPx, Mode=OneWay}"/>
                    <Run Text="x"/>
                    <Run Text="{Binding Project.CardHeightPx, Mode=OneWay}"/>
                    <Run Text="px"/>
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Layer List Panel -->
            <controls:LayerListPanel Grid.Column="0" x:Name="LayerPanel" DataContext="{Binding}"/>

            <GridSplitter Grid.Column="1" Width="3" Background="#333333"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Card Editor Canvas -->
            <controls:CardEditorCanvas Grid.Column="2" x:Name="EditorCanvas"
                                        Project="{Binding Project}"
                                        SelectedLayer="{Binding SelectedLayer, Mode=TwoWay}"
                                        RefreshTrigger="{Binding RefreshTrigger}"/>

            <GridSplitter Grid.Column="3" Width="3" Background="#333333"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Property Panel -->
            <controls:PropertyPanel Grid.Column="4" x:Name="PropPanel" DataContext="{Binding}"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="#888888" FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" Foreground="#666666" FontSize="10"
                           VerticalAlignment="Center">
                    <Run Text="Layers:"/>
                    <Run Text="{Binding Layers.Count, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
