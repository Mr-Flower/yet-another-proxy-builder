<Window x:Class="MTGProxyBuilder.UI.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Color" Height="420" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select Color" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- Preset swatches -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="SwatchPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <!-- Sliders -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="35"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="R" Foreground="#E66" FontSize="11" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" x:Name="SliderR" Minimum="0" Maximum="255"
                    ValueChanged="OnSliderChanged" Margin="4,0"/>
            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LabelR" Foreground="#CCC" FontSize="10" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="G" Foreground="#6E6" FontSize="11" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="SliderG" Minimum="0" Maximum="255"
                    ValueChanged="OnSliderChanged" Margin="4,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LabelG" Foreground="#CCC" FontSize="10" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="B" Foreground="#66E" FontSize="11" VerticalAlignment="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="SliderB" Minimum="0" Maximum="255"
                    ValueChanged="OnSliderChanged" Margin="4,0"/>
            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LabelB" Foreground="#CCC" FontSize="10" VerticalAlignment="Center"/>
        </Grid>

        <!-- Preview + Hex -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="PreviewSwatch" Width="44" Height="44" CornerRadius="4"
                    BorderBrush="#555" BorderThickness="1"/>
            <TextBox Grid.Column="1" x:Name="HexBox" Padding="6,10" FontSize="14" FontFamily="Consolas"
                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"
                     Margin="8,0,0,0" VerticalContentAlignment="Center"
                     TextChanged="OnHexChanged"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="14,7"
                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                    FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Apply" Padding="14,7"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OnApply"/>
        </StackPanel>
    </Grid>
</Window>
