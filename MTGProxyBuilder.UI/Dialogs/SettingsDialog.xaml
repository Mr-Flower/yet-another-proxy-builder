<Window x:Class="MTGProxyBuilder.UI.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="700" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Application Settings" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="DEFAULTS" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Default Token Overlay Text" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                <TextBox x:Name="TokenTextBox" Padding="6,4" FontSize="12"
                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="0,0,0,10"/>

                <TextBlock Text="Default Page Size" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                <ComboBox x:Name="PagePresetBox" Padding="4" FontSize="11" Margin="0,0,0,10">
                    <ComboBoxItem>A4</ComboBoxItem>
                    <ComboBoxItem>A3</ComboBoxItem>
                    <ComboBoxItem>Letter</ComboBoxItem>
                    <ComboBoxItem>Legal</ComboBoxItem>
                    <ComboBoxItem>Tabloid</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Default Bleed (mm)" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                <TextBox x:Name="BleedBox" Padding="6,4" FontSize="12" Width="80" HorizontalAlignment="Left"
                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="0,0,0,10"/>

                <TextBlock Text="UPDATES" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,8,0,8"/>
                <CheckBox x:Name="UpdateCheckBox" Content="Check for updates on startup" Foreground="#CCC" FontSize="11" Margin="0,0,0,10"/>

                <TextBlock Text="MPCFILL" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,8,0,8"/>

                <!-- Sources -->
                <TextBlock Text="Sources" Foreground="#999" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <CheckBox x:Name="UseFavoritesCheckBox" Content="Only use favorite sources for MPCFill searches"
                          Foreground="#CCC" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock x:Name="FavoritesInfoLabel" Foreground="#888" FontSize="10" Margin="0,0,0,6"/>
                <Button x:Name="ManageSourcesBtn" Content="Manage MPCFill Sources..." Padding="10,5"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                        HorizontalAlignment="Left" Click="OnManageSources"/>

                <!-- Search Defaults -->
                <TextBlock Text="Search Defaults" Foreground="#999" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Sort Order" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="SortByBox" Padding="4" FontSize="11">
                            <ComboBoxItem Tag="nameAscending" Content="Name A-Z"/>
                            <ComboBoxItem Tag="nameDescending" Content="Name Z-A"/>
                            <ComboBoxItem Tag="dateCreatedDescending" Content="Newest First"/>
                            <ComboBoxItem Tag="dateCreatedAscending" Content="Oldest First"/>
                            <ComboBoxItem Tag="dateModifiedDescending" Content="Recently Modified"/>
                            <ComboBoxItem Tag="dateModifiedAscending" Content="Least Recently Modified"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Max File Size (MB)" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="MaxSizeBox" Padding="6,4" FontSize="12" Width="80" HorizontalAlignment="Left"
                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Min DPI" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="DefaultMinDpiBox" Padding="4" FontSize="11">
                            <ComboBoxItem Tag="0" Content="0 (Any)"/>
                            <ComboBoxItem Tag="300" Content="300"/>
                            <ComboBoxItem Tag="600" Content="600"/>
                            <ComboBoxItem Tag="800" Content="800"/>
                            <ComboBoxItem Tag="1200" Content="1200"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Default Max DPI" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="DefaultMaxDpiBox" Padding="4" FontSize="11">
                            <ComboBoxItem Tag="300" Content="300"/>
                            <ComboBoxItem Tag="600" Content="600"/>
                            <ComboBoxItem Tag="800" Content="800"/>
                            <ComboBoxItem Tag="1200" Content="1200"/>
                            <ComboBoxItem Tag="1500" Content="1500"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="DefaultFuzzySearchBox" Content="Fuzzy search by default"
                          Foreground="#CCC" FontSize="11" Margin="0,0,0,4"/>
                <CheckBox x:Name="FilterCardbacksBox" Content="Filter out cardbacks from search results"
                          Foreground="#CCC" FontSize="11" Margin="0,0,0,4"/>

                <!-- Card Types -->
                <TextBlock Text="Card Types to Search" Foreground="#999" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <WrapPanel Margin="0,0,0,6">
                    <CheckBox x:Name="CardTypeCard" Content="Cards" Foreground="#CCC" FontSize="11" Margin="0,0,14,0"/>
                    <CheckBox x:Name="CardTypeToken" Content="Tokens" Foreground="#CCC" FontSize="11" Margin="0,0,14,0"/>
                    <CheckBox x:Name="CardTypeCardback" Content="Card Backs" Foreground="#CCC" FontSize="11"/>
                </WrapPanel>

                <!-- Languages -->
                <TextBlock Text="Languages" Foreground="#999" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,2"/>
                <TextBlock Text="Leave all unchecked to include all languages" Foreground="#666" FontSize="9" Margin="0,0,0,4"/>
                <WrapPanel Margin="0,0,0,6">
                    <CheckBox x:Name="LangEN" Content="English"    Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangJA" Content="Japanese"   Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangFR" Content="French"     Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangDE" Content="German"     Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangES" Content="Spanish"    Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangIT" Content="Italian"    Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangPT" Content="Portuguese" Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangZH" Content="Chinese"    Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangRU" Content="Russian"    Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangAR" Content="Arabic"     Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                    <CheckBox x:Name="LangSA" Content="Sanskrit"   Foreground="#CCC" FontSize="11" Margin="0,0,12,4" Width="95"/>
                </WrapPanel>

                <!-- Content Filters -->
                <TextBlock Text="Content Filters" Foreground="#999" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <CheckBox x:Name="ExcludeNsfwBox" Content="Exclude NSFW content"
                          Foreground="#CCC" FontSize="11" Margin="0,0,0,4"/>
                <CheckBox x:Name="ExcludeAiArtBox" Content="Exclude AI-generated art"
                          Foreground="#CCC" FontSize="11" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="14,7"
                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                    FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Padding="14,7"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
