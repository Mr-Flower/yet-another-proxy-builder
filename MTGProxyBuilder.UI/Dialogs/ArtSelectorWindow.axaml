<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        x:Class="MTGProxyBuilder.UI.Dialogs.ArtSelectorWindow"
        Title="Select Artwork"
        Width="1080" Height="720" MinWidth="800" MinHeight="560"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="ComboBox.Filter">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="12,8" BorderBrush="#333" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleLabel" Text="Select Front Artwork" FontSize="15"
                               FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="CardNameLabel" Text="for: card name" Foreground="#888" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox x:Name="ApplySameNameChk" IsVisible="False"/>
                    <CheckBox x:Name="ApplyNoBackChk" IsVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search + Actions bar -->
        <Grid Grid.Row="1" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:SearchBar x:Name="SearchBar" Grid.Column="0"
                                SearchRequested="OnSearchRequested"
                                SourceChanged="OnSourceChanged"/>
            <!-- Actions bar (front art library) -->
            <StackPanel x:Name="ActionsBar" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        Margin="6,0,0,0" IsVisible="False">
                <Button Content="Import from Cache" Padding="8,4" FontSize="11"
                        Background="#3E3E42" Foreground="White" BorderThickness="0"
                        Click="OnImportCacheToLibraryClick"/>
                <Button Content="+ Add to Library" Padding="8,4" FontSize="11"
                        Background="#3E3E42" Foreground="White" BorderThickness="0"
                        Click="OnAddToFrontLibraryClick"/>
            </StackPanel>
            <Button x:Name="FilterToggleBtn" Grid.Column="2" Content="Filters ▸" Padding="8,4" Margin="6,0,0,0"
                    FontSize="11" Background="#3E3E42" Foreground="White" BorderThickness="0"
                    Click="OnToggleFilters"/>
            <TextBlock x:Name="SpinnerDot" Grid.Column="3" Text="⟳" Foreground="#0078D4" FontSize="18"
                       VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="False"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left: tile grid + filter drawer -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="FilterPanelRow" Height="0"/>
                </Grid.RowDefinitions>

                <!-- Scrollable tile area -->
                <ScrollViewer Grid.Row="0" x:Name="TileScrollViewer"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Background="#1E1E1E">
                    <WrapPanel x:Name="OptionsPanel" Margin="4"/>
                </ScrollViewer>

                <!-- Collapsible MPCFill filter panel -->
                <Border Grid.Row="1" Background="#252526" BorderBrush="#333" BorderThickness="0,1,0,0"
                        Padding="12,8" IsVisible="False" x:Name="FilterPanel">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="200">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sort by" Classes="Label"/>
                                    <ComboBox x:Name="FilterSortByBox" Classes="Filter">
                                        <ComboBoxItem Content="Name A→Z" Tag="nameAscending"/>
                                        <ComboBoxItem Content="Name Z→A" Tag="nameDescending"/>
                                        <ComboBoxItem Content="DPI ↓" Tag="dpiDescending"/>
                                        <ComboBoxItem Content="DPI ↑" Tag="dpiAscending"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Min DPI" Classes="Label"/>
                                    <ComboBox x:Name="FilterMinDpiBox" Classes="Filter">
                                        <ComboBoxItem Content="Any" Tag="0"/>
                                        <ComboBoxItem Content="100" Tag="100"/>
                                        <ComboBoxItem Content="200" Tag="200"/>
                                        <ComboBoxItem Content="300" Tag="300"/>
                                        <ComboBoxItem Content="400" Tag="400"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Max DPI" Classes="Label"/>
                                    <ComboBox x:Name="FilterMaxDpiBox" Classes="Filter">
                                        <ComboBoxItem Content="500" Tag="500"/>
                                        <ComboBoxItem Content="800" Tag="800"/>
                                        <ComboBoxItem Content="1200" Tag="1200"/>
                                        <ComboBoxItem Content="1500" Tag="1500"/>
                                        <ComboBoxItem Content="Any" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Max results" Classes="Label"/>
                                    <TextBox x:Name="FilterMaxSizeBox" Text="30" Width="50"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555"
                                             FontSize="10" Padding="3,2" CaretBrush="White"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="16">
                                <CheckBox x:Name="FilterFuzzyBox" Content="Fuzzy search"/>
                                <CheckBox x:Name="FilterCardbacksBox" Content="Filter cardbacks"/>
                                <CheckBox x:Name="FilterExcludeNsfw" Content="Exclude NSFW"/>
                                <CheckBox x:Name="FilterExcludeAiArt" Content="Exclude AI Art"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="10">
                                <TextBlock Text="Types:" Foreground="#999" FontSize="10" VerticalAlignment="Center"/>
                                <CheckBox x:Name="FilterTypeCard" Content="CARD"/>
                                <CheckBox x:Name="FilterTypeToken" Content="TOKEN"/>
                                <CheckBox x:Name="FilterTypeCardback" Content="CARDBACK"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="6">
                                <TextBlock Text="Lang:" Foreground="#999" FontSize="10" VerticalAlignment="Center"/>
                                <CheckBox x:Name="FilterLangEN" Content="EN"/>
                                <CheckBox x:Name="FilterLangJA" Content="JA"/>
                                <CheckBox x:Name="FilterLangFR" Content="FR"/>
                                <CheckBox x:Name="FilterLangDE" Content="DE"/>
                                <CheckBox x:Name="FilterLangES" Content="ES"/>
                                <CheckBox x:Name="FilterLangIT" Content="IT"/>
                                <CheckBox x:Name="FilterLangPT" Content="PT"/>
                                <CheckBox x:Name="FilterLangZH" Content="ZH"/>
                                <CheckBox x:Name="FilterLangRU" Content="RU"/>
                                <CheckBox x:Name="FilterLangAR" Content="AR"/>
                                <CheckBox x:Name="FilterLangSA" Content="SA"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
                                <Button Content="Research MPCFill" Padding="10,4" FontSize="11"
                                        Background="#0078D4" Foreground="White" BorderThickness="0"
                                        Click="OnResearchMpcFill"/>
                                <Button Content="Clear Filters" Padding="10,4" FontSize="11"
                                        Background="#3E3E42" Foreground="White" BorderThickness="0"
                                        Click="OnClearFilters"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Background="#3E3E42" ResizeDirection="Columns"/>

            <!-- Right: preview + status -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:ImagePreviewPanel Grid.Row="0" x:Name="PreviewPanel"/>
                <TextBlock Grid.Row="1" x:Name="StatusLabel" Text="" Foreground="#888" FontSize="10"
                           Margin="6,4" TextWrapping="Wrap"/>
            </Grid>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="3" Background="#252526" Padding="10,6"
                BorderBrush="#333" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Cancel" Padding="14,5"
                            Background="#3E3E42" Foreground="White" BorderThickness="0"
                            Click="OnCancel"/>
                    <Button x:Name="OkBtn" Content="Select" Padding="14,5"
                            Background="#0078D4" Foreground="White" BorderThickness="0"
                            IsEnabled="False" Click="OnOk"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
