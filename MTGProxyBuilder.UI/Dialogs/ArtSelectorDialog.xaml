<Window x:Class="MTGProxyBuilder.UI.Dialogs.ArtSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Artwork" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock x:Name="TitleLabel" Text="Select Artwork" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CardNameLabel" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status / loading -->
        <Border Grid.Row="1" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusLabel" Text="Loading artwork options..." Foreground="#0078D4" FontSize="11"/>
                <TextBlock x:Name="SpinnerDot" Text="  ..." Foreground="#0078D4" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Main content: tiles + preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Options grid -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="8" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="OptionsPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Preview panel -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" x:Name="PreviewScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#111" PreviewMouseWheel="OnPreviewMouseWheel">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6">
                            <Image x:Name="FullPreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Image.LayoutTransform>
                                    <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                </Image.LayoutTransform>
                            </Image>
                        </Border>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="#1E1E1E" Padding="8,6" CornerRadius="0,0,4,4">
                        <StackPanel>
                            <TextBlock x:Name="SelectedLabel" Text="Select an image" Foreground="#CCC" FontSize="12"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SelectedDetailLabel" Foreground="#888" FontSize="10" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="-" Padding="6,1" FontSize="12" FontWeight="Bold"
                                        Background="Transparent" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomOut"/>
                                <TextBlock x:Name="PreviewZoomLabel" Text="Fit" Foreground="#888" FontSize="10"
                                           VerticalAlignment="Center" Margin="6,0" MinWidth="32" TextAlignment="Center"/>
                                <Button Content="+" Padding="6,1" FontSize="12" FontWeight="Bold"
                                        Background="Transparent" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomIn"/>
                                <Border Width="1" Background="#444" Margin="6,2"/>
                                <Button Content="Fit" Padding="5,1" FontSize="10"
                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomFit"/>
                                <Button Content="1:1" Padding="5,1" FontSize="10"
                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                        Click="PreviewZoomReset"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                <CheckBox x:Name="ApplySameNameChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed" Margin="0,0,0,2"/>
                <CheckBox x:Name="ApplyNoBackChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Padding="14,7"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkBtn" Content="Apply" Padding="14,7"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OkClick" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
