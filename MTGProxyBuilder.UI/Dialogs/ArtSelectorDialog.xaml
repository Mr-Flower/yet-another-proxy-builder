<Window x:Class="MTGProxyBuilder.UI.Dialogs.ArtSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        Title="Select Artwork" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock x:Name="TitleLabel" Text="Select Artwork" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CardNameLabel" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status / loading -->
        <Border Grid.Row="1" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusLabel" Text="Loading artwork options..." Foreground="#0078D4" FontSize="11"/>
                <TextBlock x:Name="SpinnerDot" Text="  ..." Foreground="#0078D4" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- MPCFill Filter Panel (collapsible) -->
        <Expander Grid.Row="2" x:Name="FilterExpander" Header="MPCFill Filters" IsExpanded="False"
                  Foreground="#CCC" FontSize="11" Margin="0,0,0,6">
            <Border Background="#252526" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                <StackPanel>
                    <!-- Row 1: Sort, DPI, Size -->
                    <WrapPanel Margin="0,0,0,6">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Sort Order" Foreground="#888" FontSize="9" Margin="0,0,0,2"/>
                            <ComboBox x:Name="FilterSortByBox" Padding="3" FontSize="10" Width="140">
                                <ComboBoxItem Tag="nameAscending" Content="Name A-Z"/>
                                <ComboBoxItem Tag="nameDescending" Content="Name Z-A"/>
                                <ComboBoxItem Tag="dateCreatedDescending" Content="Newest First"/>
                                <ComboBoxItem Tag="dateCreatedAscending" Content="Oldest First"/>
                                <ComboBoxItem Tag="dateModifiedDescending" Content="Recently Modified"/>
                                <ComboBoxItem Tag="dateModifiedAscending" Content="Least Recently Modified"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Min DPI" Foreground="#888" FontSize="9" Margin="0,0,0,2"/>
                            <ComboBox x:Name="FilterMinDpiBox" Padding="3" FontSize="10" Width="80">
                                <ComboBoxItem Tag="0" Content="0 (Any)"/>
                                <ComboBoxItem Tag="300" Content="300"/>
                                <ComboBoxItem Tag="600" Content="600"/>
                                <ComboBoxItem Tag="800" Content="800"/>
                                <ComboBoxItem Tag="1200" Content="1200"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Max DPI" Foreground="#888" FontSize="9" Margin="0,0,0,2"/>
                            <ComboBox x:Name="FilterMaxDpiBox" Padding="3" FontSize="10" Width="80">
                                <ComboBoxItem Tag="300" Content="300"/>
                                <ComboBoxItem Tag="600" Content="600"/>
                                <ComboBoxItem Tag="800" Content="800"/>
                                <ComboBoxItem Tag="1200" Content="1200"/>
                                <ComboBoxItem Tag="1500" Content="1500"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Max Size (MB)" Foreground="#888" FontSize="9" Margin="0,0,0,2"/>
                            <TextBox x:Name="FilterMaxSizeBox" Padding="4,3" FontSize="10" Width="60"
                                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Row 2: Toggles and Card Types -->
                    <WrapPanel Margin="0,0,0,6">
                        <CheckBox x:Name="FilterFuzzyBox" Content="Fuzzy Search" Foreground="#CCC" FontSize="10" Margin="0,0,12,0"/>
                        <CheckBox x:Name="FilterCardbacksBox" Content="Filter Cardbacks" Foreground="#CCC" FontSize="10" Margin="0,0,18,0"/>
                        <TextBlock Text="Types:" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <CheckBox x:Name="FilterTypeCard" Content="Cards" Foreground="#CCC" FontSize="10" Margin="0,0,8,0"/>
                        <CheckBox x:Name="FilterTypeToken" Content="Tokens" Foreground="#CCC" FontSize="10" Margin="0,0,8,0"/>
                        <CheckBox x:Name="FilterTypeCardback" Content="Card Backs" Foreground="#CCC" FontSize="10" Margin="0,0,0,0"/>
                    </WrapPanel>

                    <!-- Row 3: Languages -->
                    <TextBlock Text="Languages (none = all)" Foreground="#888" FontSize="9" Margin="0,0,0,2"/>
                    <WrapPanel Margin="0,0,0,6">
                        <CheckBox x:Name="FilterLangEN" Content="EN" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="48"/>
                        <CheckBox x:Name="FilterLangJA" Content="JA" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="45"/>
                        <CheckBox x:Name="FilterLangFR" Content="FR" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="45"/>
                        <CheckBox x:Name="FilterLangDE" Content="DE" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="48"/>
                        <CheckBox x:Name="FilterLangES" Content="ES" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="45"/>
                        <CheckBox x:Name="FilterLangIT" Content="IT" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="40"/>
                        <CheckBox x:Name="FilterLangPT" Content="PT" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="42"/>
                        <CheckBox x:Name="FilterLangZH" Content="ZH" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="45"/>
                        <CheckBox x:Name="FilterLangRU" Content="RU" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="45"/>
                        <CheckBox x:Name="FilterLangAR" Content="AR" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="44"/>
                        <CheckBox x:Name="FilterLangSA" Content="SA" Foreground="#CCC" FontSize="10" Margin="0,0,8,2" Width="44"/>
                    </WrapPanel>

                    <!-- Row 4: Content filters + action buttons -->
                    <WrapPanel>
                        <CheckBox x:Name="FilterExcludeNsfw" Content="Exclude NSFW" Foreground="#CCC" FontSize="10" Margin="0,0,12,0"/>
                        <CheckBox x:Name="FilterExcludeAiArt" Content="Exclude AI Art" Foreground="#CCC" FontSize="10" Margin="0,0,24,0"/>
                        <Button x:Name="ClearFiltersBtn" Content="Clear All Filters" Padding="8,3" FontSize="10"
                                Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,8,0" Click="OnClearFilters"/>
                        <Button x:Name="ResearchBtn" Content="Re-search MPCFill" Padding="8,3" FontSize="10"
                                Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="OnResearchMpcFill"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Actions bar (front mode only, populated in code-behind) -->
        <StackPanel Grid.Row="3" x:Name="ActionsBar" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
            <Button x:Name="ImportCacheBtn" Content="Import Downloaded Art" Padding="10,5" Margin="0,0,6,0"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnImportCacheToLibrary"/>
            <Button x:Name="AddToLibraryBtn" Content="Add to Library..." Padding="10,5" Margin="0,0,6,0"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnAddToFrontLibraryClick"/>
            <Button Content="Browse File..." Padding="10,5"
                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                    Click="OnBrowseFileClick"/>
        </StackPanel>

        <!-- Main content: tiles + preview -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Options grid -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="8" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="OptionsPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Preview panel -->
            <controls:ImagePreviewPanel x:Name="PreviewPanel" Grid.Column="1"/>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                <CheckBox x:Name="ApplySameNameChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed" Margin="0,0,0,2"/>
                <CheckBox x:Name="ApplyNoBackChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Padding="14,7"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkBtn" Content="Apply" Padding="14,7"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OkClick" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
