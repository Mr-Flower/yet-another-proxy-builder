<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MTGProxyBuilder.UI.Dialogs"
        x:Class="MTGProxyBuilder.UI.Dialogs.MpcSourceManagerWindow"
        Title="Manage MPCFill Sources"
        Width="680" Height="540" MinWidth="500" MinHeight="400"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#7A6FB0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#3E3E42"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#7A6FB0"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" Padding="8,6" BorderBrush="#333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshBtn" Content="Refresh from MPCFill" Padding="10,4"
                        Background="#7A6FB0" Foreground="White" BorderThickness="0"
                        Click="OnRefresh"/>
                <CheckBox x:Name="ShowFavs" Content="Show favorites only" Foreground="#CCC"/>
            </StackPanel>
        </Border>

        <!-- Search + info -->
        <Grid Grid.Row="1" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Padding="6,4" FontSize="11"
                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"
                     Watermark="Filter sources..."/>
            <TextBlock Grid.Column="1" x:Name="CountLabel" Text="Loading..."
                       Foreground="#999" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- Source list -->
        <ListBox Grid.Row="2" x:Name="SourceList"
                 Background="#1E1E1E" BorderThickness="0"
                 Margin="8,0"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <!-- Favorite star button -->
                        <Button Grid.Column="0"
                                Content="{Binding IsFavorite, Converter={x:Static local:FavStarConverter.Instance}}"
                                Foreground="{Binding IsFavorite, Converter={x:Static local:FavBrushConverter.Instance}}"
                                Background="Transparent" BorderThickness="0" Padding="2"
                                FontSize="14" Cursor="Hand"
                                Tag="{Binding Pk}"
                                Click="OnToggleFavorite"/>

                        <!-- Name + description -->
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#DDD"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="#888"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Cards count -->
                        <TextBlock Grid.Column="2" Text="{Binding CardsCount}" FontSize="10"
                                   Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,4,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Summary -->
        <TextBlock Grid.Row="3" x:Name="SummaryLabel"
                   Text="" Foreground="#888" FontSize="10" Margin="10,4" TextWrapping="Wrap"/>

        <!-- Close button -->
        <Border Grid.Row="4" Background="#252526" Padding="8,6" BorderBrush="#333" BorderThickness="0,1,0,0">
            <Button Content="Close" Padding="14,5" HorizontalAlignment="Right"
                    Background="#3E3E42" Foreground="White" BorderThickness="0"
                    Click="OnClose"/>
        </Border>
    </Grid>
</Window>
