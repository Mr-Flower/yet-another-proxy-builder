<UserControl x:Class="MTGProxyBuilder.UI.Controls.LayerListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MTGProxyBuilder.Core.Models;assembly=MTGProxyBuilder.Core"
             xmlns:local="clr-namespace:MTGProxyBuilder.UI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Image" Style="{StaticResource ToolBtn}" Click="AddImageLayer_Click"
                        ToolTip="Add image layer" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="+ Text" Style="{StaticResource ToolBtn}" Click="AddTextLayer_Click"
                        ToolTip="Add text layer" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Rectangle Width="1" Fill="#555555" Margin="4,2"/>
                <Button Content="Del" Style="{StaticResource ToolBtn}" Click="DeleteLayer_Click"
                        ToolTip="Delete selected layer" Padding="6,3" Margin="2,0" FontSize="11"/>
                <Rectangle Width="1" Fill="#555555" Margin="4,2"/>
                <Button Content="Up" Style="{StaticResource ToolBtn}" Click="MoveUp_Click"
                        ToolTip="Move layer up" Padding="6,3" Margin="2,0,0,0" FontSize="11" FontFamily="Segoe UI Symbol"/>
                <Button Content="Dn" Style="{StaticResource ToolBtn}" Click="MoveDown_Click"
                        ToolTip="Move layer down" Padding="6,3" Margin="2,0,0,0" FontSize="11" FontFamily="Segoe UI Symbol"/>
            </StackPanel>
        </Border>

        <!-- Layer List -->
        <ListBox Grid.Row="1"
                 x:Name="LayerList"
                 Background="#1E1E1E"
                 BorderThickness="0"
                 ItemsSource="{Binding Layers}"
                 SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                    <Setter Property="Padding" Value="4,3"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Visibility toggle -->
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  ToolTip="Toggle visibility"/>

                        <!-- Layer type icon -->
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="#888888">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="?"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Converter={x:Static local:LayerTypeConverter.Instance}}" Value="Image">
                                            <Setter Property="Text" Value="Img"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Converter={x:Static local:LayerTypeConverter.Instance}}" Value="Text">
                                            <Setter Property="Text" Value="T"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Layer name -->
                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
