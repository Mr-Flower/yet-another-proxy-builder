<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MTGProxyBuilder.UI.Controls.SearchBar">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Search box with placeholder -->
        <Grid Grid.Column="0">
            <TextBox x:Name="SearchTextBox" Padding="6,4" FontSize="11"
                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"
                     KeyDown="OnKeyDown" TextChanged="OnTextChanged"
                     ToolTip.Tip="Scryfall-like syntax: name:text t:type source:text r:rarity c:color s:set a:artist o:oracle kw:keyword cmc>3 pow>=4 date>2025-01-01 &quot;exact phrase&quot; -exclude term1 OR term2 (groups)"/>
            <TextBlock x:Name="PlaceholderBlock" Text="Search..."
                       Foreground="#666" FontSize="11" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- Search button -->
        <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Padding="10,4" Margin="4,0,0,0"
                Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                Click="OnSearchButtonClick"/>

        <!-- Source filter dropdown -->
        <ComboBox x:Name="SourceCombo" Grid.Column="2"
                  Width="160" Margin="4,0,0,0" Padding="4" FontSize="11"
                  SelectionChanged="OnSourceSelectionChanged"/>
    </Grid>
</UserControl>
