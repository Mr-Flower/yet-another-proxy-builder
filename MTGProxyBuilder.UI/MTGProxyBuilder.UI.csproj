<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>tcg-proxy-builder</AssemblyName>
    <Product>TCG Proxy Builder</Product>
    <Version>0.0.0-dev</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTGProxyBuilder.Core\MTGProxyBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.*" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.*" />
    <!-- 2.88.9 is the minimum required by Avalonia.Skia 11.2.8.
         Native lib (libSkiaSharp.so) is v88 regardless of NativeAssets package
         version; managed 2.88.9 accepts native v88. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <!-- Exclude all legacy WPF files (replaced by .axaml.cs counterparts) -->
  <ItemGroup>
    <Compile Remove="AssemblyInfo.cs" />
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="Controls\ImagePreviewPanel.xaml.cs" />
    <Compile Remove="Controls\LayerListPanel.xaml.cs" />
    <Compile Remove="Controls\PropertyPanel.xaml.cs" />
    <Compile Remove="Controls\SearchBar.xaml.cs" />
    <Compile Remove="Dialogs\ArtSelectorDialog.xaml.cs" />
    <Compile Remove="Dialogs\BackArtLibraryDialog.xaml.cs" />
    <Compile Remove="Dialogs\BackArtSelectorDialog.xaml.cs" />
    <Compile Remove="Dialogs\ColorPickerDialog.xaml.cs" />
    <Compile Remove="Dialogs\FrontArtLibraryDialog.xaml.cs" />
    <Compile Remove="Dialogs\ImagePreviewDialog.xaml.cs" />
    <Compile Remove="Dialogs\MpcSourceManagerDialog.xaml.cs" />
    <Compile Remove="Dialogs\SettingsDialog.xaml.cs" />
    <Compile Remove="Dialogs\CardEditorWindow.xaml.cs" />
  </ItemGroup>


  <!-- Prevent old WPF XAML from being processed as resources -->
  <ItemGroup>
    <None Include="**\*.xaml" />
    <EmbeddedResource Remove="**\*.xaml" />
    <Page Remove="**\*.xaml" />
  </ItemGroup>

</Project>
