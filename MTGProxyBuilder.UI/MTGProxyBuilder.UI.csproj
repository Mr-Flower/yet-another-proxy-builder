<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>tcg-proxy-builder</AssemblyName>
    <Product>TCG Proxy Builder</Product>
    <Version>0.0.0-dev</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Embeds the icon into the Windows .exe. -->
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- App assets (window icon, etc.) bundled as Avalonia resources so /Assets/... resolves at runtime. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTGProxyBuilder.Core\MTGProxyBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.*" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.*" />
    <!-- 2.88.9 is the minimum required by Avalonia.Skia 11.2.8.
         Native lib (libSkiaSharp.so) is v88 regardless of NativeAssets package
         version; managed 2.88.9 accepts native v88. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <!-- Legacy WPF AssemblyInfo (kept on disk, excluded so the SDK auto-generates assembly attributes
       instead). The rest of the old WPF *.xaml / *.xaml.cs set has been deleted. -->
  <ItemGroup>
    <Compile Remove="AssemblyInfo.cs" />
  </ItemGroup>

</Project>
